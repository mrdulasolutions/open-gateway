{
  "mcpServers": {
    "opengateway": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/path/to/open-gateway",
        "opengateway",
        "mcp"
      ],
      "env": {
        "OPENGATEWAY_URL": "https://YOUR-APP.up.railway.app",
        "OPENGATEWAY_AUTH_TOKEN": "ogk_from_live_ops_ui",
        "OPENGATEWAY_HARNESS": "grok",
        "OPENGATEWAY_AGENT_NAME": "grok"
      }
    }
  }
}
